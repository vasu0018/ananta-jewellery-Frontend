# Port for `npm run dev` / `npm start`
PORT=3005

# Ananta Jewellery API origin ("/api/v1" is appended automatically)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this storefront (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Optional: extra HTTPS host serving product images (S3 / CDN)
NEXT_PUBLIC_MEDIA_HOST=

# Development only: lets next/image fetch from an API on localhost/private IPs.
# Leave unset in production (it would allow server-side requests to your private network).
IMAGES_ALLOW_LOCAL_IP=1
